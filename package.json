{
  "name": "sp-digital-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @sp/api prisma:generate",
    "db:migrate": "pnpm --filter @sp/api prisma:migrate",
    "db:seed": "pnpm --filter @sp/api exec prisma db seed",
    "db:studio": "pnpm --filter @sp/api exec prisma studio",
    "setup:github": "bash scripts/setup-github.sh",
    "setup:branches": "bash scripts/setup-branches.sh",
    "prepare": "husky",
    "mvp": "bash scripts/mvp.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}

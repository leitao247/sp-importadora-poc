# Ambiente
NODE_ENV=development

# API
API_PORT=3001

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://sp:sp@localhost:5432/sp_commerce?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Autenticação Admin (troque em produção!)
ADMIN_API_KEY=dev-admin-key-sp-2025

# Web (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Geocoding – Nominatim / OpenStreetMap
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=sp-importadora-dev/1.0
GEOCODER_EMAIL=dev@example.com
GEOCODER_RATE_LIMIT_MS=1100

# Roteamento
ROUTING_DEFAULT_MAX_KM=150

# Frete
SHIPPING_RULE_STRATEGY=CEP_RANGE

# Pagamentos (adapter futuro)
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=TEST-your-token-here

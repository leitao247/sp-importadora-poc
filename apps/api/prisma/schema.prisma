// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// PRODUTOS
// ─────────────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  priceBox    Decimal  @db.Decimal(10, 2)
  unitsPerBox Int      @default(1)
  priceUnit   Decimal  @db.Decimal(10, 2)
  bottleMl    Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([active])
  @@map("products")
}

// ─────────────────────────────────────────────
// DISTRIBUIDORES
// ─────────────────────────────────────────────
model Distributor {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  cep             String
  lat             Float?
  lng             Float?
  serviceRadiusKm Float?
  priority        Int      @default(100)
  active          Boolean  @default(true)
  emitsNf         Boolean  @default(true)
  apiKey          String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders           Order[]
  routingDecisions RoutingDecision[]

  @@index([active])
  @@map("distributors")
}

// ─────────────────────────────────────────────
// CACHE DE GEOCODING
// ─────────────────────────────────────────────
model GeoCache {
  id        String   @id @default(cuid())
  key       String   @unique // ex: "cep:80010000"
  lat       Float
  lng       Float
  provider  String   @default("nominatim")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("geo_cache")
}

// ─────────────────────────────────────────────
// ZONAS DE FRETE
// ─────────────────────────────────────────────
model ShippingZone {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  price     Decimal  @db.Decimal(10, 2)
  priority  Int      @default(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ranges ShippingZoneCepRange[]

  @@map("shipping_zones")
}

model ShippingZoneCepRange {
  id           String    @id @default(cuid())
  zoneId       String
  zone         ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  cepStart     String
  cepEnd       String
  cepStartInt  Int
  cepEndInt    Int
  spanInt      Int       // cepEndInt - cepStartInt (para desempate)
  active       Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active, cepStartInt, cepEndInt])
  @@index([zoneId, active])
  @@map("shipping_zone_cep_ranges")
}

// ─────────────────────────────────────────────
// PEDIDOS
// ─────────────────────────────────────────────
enum OrderStatus {
  CREATED
  ASSIGNED
  ACCEPTED
  PACKING
  SHIPPED
  DELIVERED
  CANCELED
}

model Order {
  id                    String      @id @default(cuid())
  customerName          String
  customerEmail         String?
  customerCep           String
  customerLat           Float?
  customerLng           Float?
  status                OrderStatus @default(CREATED)
  subtotal              Decimal     @db.Decimal(10, 2)
  shippingPrice         Decimal     @db.Decimal(10, 2) @default(0)
  total                 Decimal     @db.Decimal(10, 2)
  assignedDistributorId String?
  assignedDistributor   Distributor? @relation(fields: [assignedDistributorId], references: [id])
  shippingZoneCode      String?
  shippingZoneName      String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  routingDecision  RoutingDecision?
  events           OrderEvent[]

  @@index([status])
  @@index([assignedDistributorId])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  productCode String
  productName String
  sellType   String   @default("UNIT") // UNIT | BOX
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  lineTotal  Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus  OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// ─────────────────────────────────────────────
// DECISÃO DE ROTEAMENTO (auditoria)
// ─────────────────────────────────────────────
model RoutingDecision {
  id                   String   @id @default(cuid())
  orderId              String   @unique
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  distributorId        String
  distributor          Distributor @relation(fields: [distributorId], references: [id])
  customerLat          Float
  customerLng          Float
  distanceKm           Float
  candidatesJson       Json     // lista de candidatos avaliados
  createdAt            DateTime @default(now())

  @@map("routing_decisions")
}

// ─────────────────────────────────────────────
// EVENTOS DE PEDIDO (audit log)
// ─────────────────────────────────────────────
enum OrderEventType {
  ORDER_CREATED
  ORDER_ASSIGNED
  ORDER_STATUS_CHANGED
}

model OrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  payload   Json?
  createdAt DateTime       @default(now())

  @@index([orderId])
  @@map("order_events")
}
